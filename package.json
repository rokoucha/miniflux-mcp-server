{
  "name": "miniflux-mcp-server",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.26.0",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "express": "5.3.0",
    "jose": "6.2.17",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "prettier --check src docs *.json .github/workflows",
    "format": "prettier --write src docs *.json .github/workflows",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
